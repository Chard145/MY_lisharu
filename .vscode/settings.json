{
    // ===================== C/C++ 代码导航配置 =====================
    // 目标：VSCode 里能对函数/变量做「转到定义 / 速览定义 / 查找引用」。
    //
    // 本机情况（已实测）：
    //   - clangd 扩展装了，但**没有 clangd 主程序**（未装 LLVM，扩展也没下载成功）
    //     -> clangd 语言服务起不来 -> 右键菜单里没有「转到定义」
    //   - cpptools（微软 C/C++）自带解析器 cpptools-srv2.exe，离线可用
    //   => 方案：用 cpptools，关掉 clangd

    "cmake.sourceDirectory": "C:/Users/chard/Desktop/MY_lisharu/project",

    // ---------- (1) 关掉 clangd，改用 cpptools ----------
    "clangd.enable": false,
    "clangd.detectExtensionConflicts": false,

    // ---------- (2) 打开 cpptools 的 IntelliSense ----------
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.intelliSenseEngineFallback": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.formatting": "default",

    // ---------- (3) 用 CMake 生成的编译数据库（最准确的索引来源）----------
    // 工作区根目录的 compile_commands.json 是指向 project/build/Debug/ 的硬链接
    "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",

    // ---------- (4) 兜底：万一时序上读不到编译数据库，用这些默认值解析 ----------
    "C_Cpp.default.cStandard": "gnu11",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.compilerPath": "D:/AI_Models/ARM_GNU_Toolchain/arm-gnu-toolchain-15.2.rel1-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc.exe",
    "C_Cpp.default.defines": [
        "STM32G431xx",
        "USE_HAL_DRIVER",
        "DEBUG"
    ],
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/project/Core/Inc",
        "${workspaceFolder}/project/Drivers/STM32G4xx_HAL_Driver/Inc",
        "${workspaceFolder}/project/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/project/Drivers/CMSIS/Device/ST/STM32G4xx/Include",
        "${workspaceFolder}/project/Drivers/CMSIS/Include"
    ],

    // ---------- (5) 索引时跳过 build 目录，加快速度 ----------
    "C_Cpp.files.exclude": {
        "**/.vscode": true,
        "**/.vs": true,
        "**/build": true
    },
    "search.exclude": {
        "**/build": true
    },

    // ---------- (6) arm 汇编/链接脚本高亮 ----------
    "files.associations": {
        "*.ld": "ld",
        "*.s": "arm"
    }
}
