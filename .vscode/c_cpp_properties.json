{
    // cpptools 的工程级配置（兜底用，保证不依赖自动解析也能正确索引）
    // 硬件平台：STM32G431C8T6 (LQFP48, Cortex-M4F)
    "configurations": [
        {
            "name": "STM32G431",
            // 优先用 CMake 生成的编译数据库（最准确）
            "compileCommands": "${workspaceFolder}/compile_commands.json",

            // 万一读不到编译数据库，下面这些显式配置仍然能让索引正确
            "compilerPath": "D:/AI_Models/ARM_GNU_Toolchain/arm-gnu-toolchain-15.2.rel1-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc.exe",
            "cStandard": "gnu11",
            "intelliSenseMode": "gcc-arm",
            "defines": [
                "STM32G431xx",
                "USE_HAL_DRIVER",
                "DEBUG"
            ],
            "includePath": [
                "${workspaceFolder}/project/Core/Inc",
                "${workspaceFolder}/project/Drivers/STM32G4xx_HAL_Driver/Inc",
                "${workspaceFolder}/project/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/project/Drivers/CMSIS/Device/ST/STM32G4xx/Include",
                "${workspaceFolder}/project/Drivers/CMSIS/Include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/project/Core",
                    "${workspaceFolder}/project/Drivers"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
